LIST P=16F887
    #include <p16f887.inc>

    __CONFIG _CONFIG1, _XT_OSC & _WDTE_OFF & _PWRTE_ON & _MCLRE_ON & _CP_OFF & _CPD_OFF & _BOREN_OFF & _IESO_OFF & _FCMEN_OFF & _LVP_OFF
    __CONFIG _CONFIG2, _BOR4V_BOR40V & _WRT_OFF

    CBLOCK 0X70
    W_TEMP
    STATUS_TEMP
    DIG_ACTUAL
    DIG0                
    DIG1                
    CONT_INT
    DEL1
    DEL2
    ESTADO              
    RX_DATO             
    CADENA_RX4          
    PTR_BUFF            
    RET_CAUDAL          
    ENDC

    ORG 0X00
    GOTO INICIO
    ORG 0X04
    GOTO ISR

;------------------------------------------------------------
; TABLAS
;------------------------------------------------------------
HABILITACION_DISPLAY
    ADDWF PCL,F
    RETLW b'00000001'
    RETLW b'00000010'

TABLA_DISP
    ADDWF PCL,F
    RETLW 0xC0 ;0
    RETLW 0xF9 ;1
    RETLW 0xA4 ;2
    RETLW 0xB0 ;3
    RETLW 0x99 ;4
    RETLW 0x92 ;5
    RETLW 0x82 ;6
    RETLW 0xF8 ;7
    RETLW 0x80 ;8
    RETLW 0x90 ;9

;------------------------------------------------------------
; CONFIGURACION
;------------------------------------------------------------
INICIO
    BSF STATUS,RP1
    BSF STATUS,RP0          

    MOVLW 0X01
    MOVWF ANSEL            
    MOVLW 0X00
    MOVWF ANSELH

    BCF STATUS,RP1
    BSF STATUS,RP0         

    MOVLW B'00000001'
    MOVWF TRISA

    MOVLW B'00000001'
    MOVWF TRISB

    MOVLW B'11000000'
    MOVWF TRISC

    CLRF TRISD

    BSF TRISE,0
    BSF TRISE,1

    ; Timer0 
    BCF OPTION_REG,5
    BCF OPTION_REG,3
    BSF OPTION_REG,2
    BCF OPTION_REG,1
    BCF OPTION_REG,0

    ; UART 
    MOVLW .25
    MOVWF SPBRG
    BSF TXSTA,BRGH
    BCF TXSTA,SYNC
    BSF TXSTA,TXEN
    BSF PIE1,RCIE

    ; ADC
    CLRF ADCON1

    BCF STATUS,RP1
    BCF STATUS,RP0          

    CLRF PORTD
    CLRF PORTB
    CLRF PORTC
    BSF PORTB,3             

    BSF RCSTA,SPEN
    BSF RCSTA,CREN

    
    MOVLW B'01000001'
    MOVWF ADCON0

    CLRF ESTADO

    MOVLW .15               
    MOVWF RET_CAUDAL

   
    CALL RESET_10
    CLRF DIG_ACTUAL
    MOVLW .2
    MOVWF CONT_INT
    MOVLW .100
    MOVWF TMR0

    BCF INTCON,T0IF
    BSF INTCON,T0IE
    BSF INTCON,PEIE
    BSF INTCON,GIE

;------------------------------------------------------------
; PROGRAMA PRINCIPAL
;------------------------------------------------------------
BUCLE_PRINCIPAL
    CALL LEER_Y_ESCALAR_ADC

    MOVF ESTADO,F           
    BTFSC STATUS,Z
    GOTO PARADO

    BTFSS PORTE,1
    GOTO FIN_JERINGA

    CALL MOTOR_ON
    CALL GIRO_AVANCE
    CALL GENERAR_PASO

    GOTO BUCLE_PRINCIPAL

PARADO
    CALL MOTOR_OFF
    GOTO BUCLE_PRINCIPAL

FIN_JERINGA
    CALL MOTOR_OFF
    CLRF ESTADO
    GOTO BUCLE_PRINCIPAL

;------------------------------------------------------------
; LECTURA Y ESCALADO DEL ADC (AN0 - RA0) A mL
;------------------------------------------------------------
LEER_Y_ESCALAR_ADC
    MOVLW .8
    MOVWF DEL2
ESPERA_ADQ
    DECFSZ DEL2,F
    GOTO ESPERA_ADQ         

    BSF ADCON0,GO_DONE      

ESPERAR_ADC
    BTFSC ADCON0,GO_DONE    
    GOTO ESPERAR_ADC

    MOVF ADRESH,W           


    SUBLW .225              
    BTFSS STATUS,C
    GOTO CARGAR_10_ML

    CLRF DIG1              

    MOVF ADRESH,W
    SUBLW .203
    BTFSS STATUS,C
    GOTO CARGAR_09_ML


    MOVF ADRESH,W
    SUBLW .180
    BTFSS STATUS,C
    GOTO CARGAR_08_ML


    MOVF ADRESH,W
    SUBLW .158
    BTFSS STATUS,C
    GOTO CARGAR_07_ML

 
    MOVF ADRESH,W
    SUBLW .135
    BTFSS STATUS,C
    GOTO CARGAR_06_ML


    MOVF ADRESH,W
    SUBLW .113
    BTFSS STATUS,C
    GOTO CARGAR_05_ML


    MOVF ADRESH,W
    SUBLW .90
    BTFSS STATUS,C
    GOTO CARGAR_04_ML

   
    MOVF ADRESH,W
    SUBLW .68
    BTFSS STATUS,C
    GOTO CARGAR_03_ML

 
    MOVF ADRESH,W
    SUBLW .45
    BTFSS STATUS,C
    GOTO CARGAR_02_ML

 
    MOVF ADRESH,W
    SUBLW .23
    BTFSS STATUS,C
    GOTO CARGAR_01_ML


    CLRF DIG0
    RETURN

CARGAR_10_ML
    MOVLW .1
    MOVWF DIG1
    CLRF DIG0             
    RETURN

CARGAR_09_ML
    MOVLW .9
    MOVWF DIG0
    RETURN

CARGAR_08_ML
    MOVLW .8
    MOVWF DIG0
    RETURN

CARGAR_07_ML
    MOVLW .7
    MOVWF DIG0
    RETURN

CARGAR_06_ML
    MOVLW .6
    MOVWF DIG0
    RETURN

CARGAR_05_ML
    MOVLW .5
    MOVWF DIG0
    RETURN

CARGAR_04_ML
    MOVLW .4
    MOVWF DIG0
    RETURN

CARGAR_03_ML
    MOVLW .3
    MOVWF DIG0
    RETURN

CARGAR_02_ML
    MOVLW .2
    MOVWF DIG0
    RETURN

CARGAR_01_ML
    MOVLW .1
    MOVWF DIG0
    RETURN

;------------------------------------------------------------
; MOTOR / DRIVER
;------------------------------------------------------------
MOTOR_ON
    BCF PORTB,3
    RETURN

MOTOR_OFF
    BSF PORTB,3
    RETURN

GIRO_AVANCE
    BSF PORTB,2
    RETURN

GIRO_RETROCESO
    BCF PORTB,2
    RETURN

GENERAR_PASO
    BSF PORTB,1          
    NOP
    NOP
    BCF PORTB,1            
    CALL RETARDO_VARIABLE
    RETURN

RETARDO_VARIABLE
    MOVF RET_CAUDAL,W
    MOVWF DEL1
LOOP_VAR_EXT
    MOVLW .250
    MOVWF DEL2
LOOP_VAR_INT
    NOP
    NOP
    DECFSZ DEL2,F
    GOTO LOOP_VAR_INT
    DECFSZ DEL1,F
    GOTO LOOP_VAR_EXT
    RETURN

;------------------------------------------------------------
; INTERRUPCION
;------------------------------------------------------------
ISR
    MOVWF W_TEMP
    SWAPF STATUS,W
    MOVWF STATUS_TEMP

    BTFSC INTCON,T0IF
    GOTO ISR_TMR0

    BTFSC PIR1,RCIF        
    GOTO ISR_RX

    GOTO FIN_ISR

;  Timer0 
ISR_TMR0
    BCF INTCON,T0IF
    MOVLW .100
    MOVWF TMR0

    CALL REFRES_DISP

    DECFSZ CONT_INT,F
    GOTO FIN_ISR
    MOVLW .2
    MOVWF CONT_INT
    
    GOTO FIN_ISR

; UART
ISR_RX
    BTFSS RCSTA,OERR       
    GOTO RX_LEER
    BCF RCSTA,CREN          
    BSF RCSTA,CREN
    GOTO FIN_ISR

RX_LEER
    MOVF RCREG,W           
    MOVWF RX_DATO
    MOVWF TXREG             

    MOVLW 'S'               
    SUBWF RX_DATO,W
    BTFSC STATUS,Z
    GOTO RX_START

    MOVLW 'P'              
    SUBWF RX_DATO,W
    BTFSC STATUS,Z
    GOTO RX_PAUSA

    GOTO FIN_ISR

RX_START
    MOVLW .1
    MOVWF ESTADO
    GOTO FIN_ISR

RX_PAUSA
    CLRF ESTADO
    GOTO FIN_ISR

;------------------------------------------------------------
; SUBRUTINAS TIMER0 (display)
;------------------------------------------------------------
REFRES_DISP
    BCF PORTC,0
    BCF PORTC,1

    MOVF DIG_ACTUAL,W
    BTFSC STATUS,Z
    GOTO MOSTRAR_DIG0

    GOTO MOSTRAR_DIG1

MOSTRAR_DIG0
    MOVF DIG0,W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR

MOSTRAR_DIG1
    MOVF DIG1,W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR

HABILITAR
    MOVF DIG_ACTUAL,W
    CALL HABILITACION_DISPLAY
    IORWF PORTC,F

SIG_DISP
    INCF DIG_ACTUAL,F
    MOVLW .2
    SUBWF DIG_ACTUAL,W
    BTFSS STATUS,Z
    RETURN

    CLRF DIG_ACTUAL
    RETURN

RESET_10
    MOVLW .1
    MOVWF DIG1
    CLRF DIG0
    RETURN

;------------------------------------------------------------
; FINAL DE INTERRUPCIONES
;------------------------------------------------------------
FIN_ISR
    SWAPF STATUS_TEMP,W
    MOVWF STATUS
    SWAPF W_TEMP,F
    SWAPF W_TEMP,W
    RETFIE

    END
