LIST P=16F887
    #include <p16f887.inc>

    __CONFIG _CONFIG1, _XT_OSC & _WDTE_OFF & _PWRTE_ON & _MCLRE_ON & _CP_OFF & _CPD_OFF & _BOREN_OFF & _IESO_OFF & _FCMEN_OFF & _LVP_OFF
    __CONFIG _CONFIG2, _BOR4V_BOR40V & _WRT_OFF

    CBLOCK 0X70
    W_TEMP
    STATUS_TEMP
    DIG_ACTUAL
    DIG0
    DIG1
    CONT_INT
    DEL1
    DEL2
    ESTADO              ; 0 = parado / pausa, 1 = infundiendo
    RX_DATO             ; ultimo byte recibido por UART
    ENDC

    ORG 0X00
    GOTO INICIO
    ORG 0X04
    GOTO ISR

;------------------------------------------------------------
; CONFIGURACION
;------------------------------------------------------------
INICIO
    BSF STATUS,RP1
    BSF STATUS,RP0          ; banco 3

    MOVLW 0X01
    MOVWF ANSEL
    MOVLW 0X00
    MOVWF ANSELH

    BCF STATUS,RP1
    BSF STATUS,RP0          ; banco 1

    MOVLW B'00000001'
    MOVWF TRISA

    MOVLW B'00000001'
    MOVWF TRISB

    MOVLW B'11000000'       
    MOVWF TRISC

    CLRF TRISD

    BSF TRISE,0
    BSF TRISE,1

    ; Timer0 (display)
    BCF OPTION_REG,5
    BCF OPTION_REG,3
    BSF OPTION_REG,2
    BCF OPTION_REG,1
    BCF OPTION_REG,0

    ; NUEVO: UART 9600 baudios con cristal de 4 MHz
    MOVLW .25
    MOVWF SPBRG
    BSF TXSTA,BRGH
    BCF TXSTA,SYNC          
    BSF TXSTA,TXEN          
    BSF PIE1,RCIE        
                            

    BCF STATUS,RP1
    BCF STATUS,RP0          ; banco 0 

    CLRF PORTD
    CLRF PORTB
    CLRF PORTC
    BSF PORTB,3             

    BSF RCSTA,SPEN          
    BSF RCSTA,CREN          

    CLRF ESTADO             

    ; Setear en 99
    CALL RESET_99
    CLRF DIG_ACTUAL
    MOVLW .2
    MOVWF CONT_INT
    MOVLW .100
    MOVWF TMR0

    BCF INTCON,T0IF
    BSF INTCON,T0IE
    BSF INTCON,PEIE         
    BSF INTCON,GIE

;------------------------------------------------------------
; PROGRAMA PRINCIPAL
;------------------------------------------------------------
BUCLE_PRINCIPAL
    MOVF ESTADO,F           ; NUEVO: si ESTADO = 0 no se mueve el motor
    BTFSC STATUS,Z
    GOTO PARADO

    BTFSS PORTE,1
    GOTO FIN_JERINGA

    CALL MOTOR_ON
    CALL GIRO_AVANCE
    CALL GENERAR_PASO

    GOTO BUCLE_PRINCIPAL

PARADO
    CALL MOTOR_OFF
    GOTO BUCLE_PRINCIPAL

FIN_JERINGA
    CALL MOTOR_OFF
    CLRF ESTADO             
    GOTO BUCLE_PRINCIPAL

;------------------------------------------------------------
; MOTOR / DRIVER
;------------------------------------------------------------
MOTOR_ON
    BCF PORTB,3
    RETURN

MOTOR_OFF
    BSF PORTB,3
    RETURN              

GIRO_AVANCE
    BSF PORTB,2
    RETURN

GIRO_RETROCESO
    BCF PORTB,2
    RETURN

GENERAR_PASO
    BSF PORTB,1
    NOP
    NOP
    BCF PORTB,1
    CALL RETARDO_PRUEBA
    RETURN

RETARDO_PRUEBA
    MOVLW .15
    MOVWF DEL1
LOOP_DEMO_EXT
    MOVLW .250
    MOVWF DEL2
LOOP_DEMO_INT
    NOP
    NOP
    DECFSZ DEL2,F
    GOTO LOOP_DEMO_INT
    DECFSZ DEL1,F
    GOTO LOOP_DEMO_EXT
    RETURN

;------------------------------------------------------------
; INTERRUPCION
;------------------------------------------------------------
ISR
    MOVWF W_TEMP
    SWAPF STATUS,W
    MOVWF STATUS_TEMP

    BTFSC INTCON,T0IF
    GOTO ISR_TMR0

    BTFSC PIR1,RCIF         ;llego un dato por UART
    GOTO ISR_RX

    GOTO FIN_ISR

; --- Timer0 (overflow) ---
ISR_TMR0
    BCF INTCON,T0IF
    MOVLW .100
    MOVWF TMR0

    CALL REFRES_DISP

    DECFSZ CONT_INT,F
    GOTO FIN_ISR
    MOVLW .2
    MOVWF CONT_INT
    ; aca va lo que se quiera hacer cada 10 ms
    GOTO FIN_ISR           

; --- UART: recepcion ---
ISR_RX
    BTFSS RCSTA,OERR        ; hubo desborde?
    GOTO RX_LEER
    BCF RCSTA,CREN          ; reinicia la recepcion para limpiar el error
    BSF RCSTA,CREN
    GOTO FIN_ISR

RX_LEER
    MOVF RCREG,W            ; leer RCREG baja la bandera RCIF
    MOVWF RX_DATO
    MOVWF TXREG             ; ECO: devuelve a la PC lo que recibio

    ; Comandos de prueba (despues se reemplazan por el parser)
    MOVLW 'S'
    SUBWF RX_DATO,W
    BTFSC STATUS,Z
    GOTO RX_START

    MOVLW 'P'
    SUBWF RX_DATO,W
    BTFSC STATUS,Z
    GOTO RX_PAUSA

    GOTO FIN_ISR

RX_START
    MOVLW .1
    MOVWF ESTADO
    GOTO FIN_ISR

RX_PAUSA
    CLRF ESTADO
    GOTO FIN_ISR

;------------------------------------------------------------
; SUBRUTINAS TIMER0 (display)
;------------------------------------------------------------
REFRES_DISP
    BCF PORTC,0
    BCF PORTC,1

    MOVF DIG_ACTUAL,W
    BTFSC STATUS,Z
    GOTO MOSTRAR_DIG0

    GOTO MOSTRAR_DIG1

MOSTRAR_DIG0
    MOVF DIG0,W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR

MOSTRAR_DIG1
    MOVF DIG1,W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR

HABILITAR
    MOVF DIG_ACTUAL,W
    CALL HABILITACION_DISPLAY
    IORWF PORTC,F           

SIG_DISP
    INCF DIG_ACTUAL,F
    MOVLW .2
    SUBWF DIG_ACTUAL,W
    BTFSS STATUS,Z
    RETURN

    CLRF DIG_ACTUAL
    RETURN

RESET_99
    MOVLW .9
    MOVWF DIG0
    MOVWF DIG1
    RETURN

;------------------------------------------------------------
; FINAL DE INTERRUPCIONES
;------------------------------------------------------------
FIN_ISR
    SWAPF STATUS_TEMP,W
    MOVWF STATUS
    SWAPF W_TEMP,F
    SWAPF W_TEMP,W
    RETFIE

HABILITACION_DISPLAY
    ADDWF PCL,F
    RETLW b'00000001'
    RETLW b'00000010'

TABLA_DISP
    ADDWF PCL,F
    RETLW 0xC0 ;0
    RETLW 0xF9 ;1
    RETLW 0xA4 ;2
    RETLW 0xB0 ;3
    RETLW 0x99 ;4
    RETLW 0x92 ;5
    RETLW 0x82 ;6
    RETLW 0xF8 ;7
    RETLW 0x80 ;8
    RETLW 0x90 ;9

    END
