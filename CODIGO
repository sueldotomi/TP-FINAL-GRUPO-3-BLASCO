LIST P=16F887
    #include <p16f887.inc>

    __CONFIG _CONFIG1, _XT_OSC & _WDTE_OFF & _PWRTE_ON & _MCLRE_ON & _CP_OFF & _CPD_OFF & _BOREN_OFF & _IESO_OFF & _FCMEN_OFF & _LVP_OFF
    __CONFIG _CONFIG2, _BOR4V_BOR40V & _WRT_OFF

    CBLOCK 0X70
    W_TEMP
    STATUS_TEMP
    DIG_ACTUAL
    DIG0
    DIG1
    CONT_INT
    DEL1
    DEL2
    
    ENDC
    
    ORG 0X00
    GOTO INICIO
    ORG 0X04
    GOTO ISR

   ;Configuracion de puertos
   INICIO
   BSF STATUS, RP1
   BSF STATUS, RP0
   
   MOVLW 0X01
   MOVWF ANSEL
   MOVLW 0X00
   MOVWF ANSELH
   
   BCF STATUS,RP1
   BSF STATUS,RP0
   
   MOVLW B'00000001'
   MOVWF TRISA
   
   MOVLW B'00000001'
   MOVWF TRISB
   
   MOVLW B'10000000'
   MOVWF TRISC
   
   CLRF TRISD
   
   BSF TRISE,0
   BSF TRISE,1
   
   BCF STATUS,RP1
   BCF STATUS,RP0
   
   CLRF PORTD
   CLRF PORTB
   CLRF PORTC
   
    ; Setear en 99
   CALL RESET_99
   CLRF DIG_ACTUAL
   MOVLW .2
   MOVWF CONT_INT
   MOVLW .100
   MOVWF TMR0

   
   BCF INTCON, T0IF        
   BSF INTCON, T0IE        
   BSF INTCON, GIE         

   
   BCF STATUS,RP1
   BSF STATUS,RP0
   
   ;solo para timer por ahora
   BCF OPTION_REG, 5       
   BCF OPTION_REG, 3       
   BSF OPTION_REG, 2       
   BCF OPTION_REG, 1
   BCF OPTION_REG, 0
   
   
   BUCLE_PRINCIPAL
    BTFSS PORTE,1
    GOTO FIN_JERINGA
    
    CALL MOTOR_ON
    CALL GIRO_AVANCE
    CALL GENERAR_PASO
    
    GOTO BUCLE_PRINCIPAL
    
    FIN_JERINGA
    CALL MOTOR_OFF
    ;aca encender buzzer
    GOTO BUCLE_PRINCIPAL
     
    
   ;MOTOR/DRIVER
   ;habilito/deshabilito el driver
   MOTOR_ON
   BCF PORTB,3 
   RETURN
   
   MOTOR_OFF
   BSF PORTB,3
   
   GIRO_AVANCE
   BSF PORTB,2
   RETURN
   
   GIRO_RETROCESO
   BCF PORTB, 2        
   RETURN
   
   GENERAR_PASO
   BSF PORTB, 1        
   NOP                 
   NOP
   BCF PORTB, 1        
   CALL RETARDO_PRUEBA 
   RETURN
   
   RETARDO_PRUEBA
   MOVLW .13
   MOVWF DEL1
   LOOP_DEMO_EXT
   MOVLW .250
   MOVWF DEL2
   LOOP_DEMO_INT
   DECFSZ DEL2, F
   GOTO LOOP_DEMO_INT
   DECFSZ DEL1, F
   GOTO LOOP_DEMO_EXT
   RETURN
   
   ;Interrupcion
  
   ISR
   MOVWF W_TEMP
   SWAPF STATUS,W
   MOVWF STATUS_TEMP
   
   BTFSC INTCON,T0IF
   GOTO ISR_TMR0
   
   
   GOTO FIN_ISR
   
   ;INTERRUPCION TIMER(OVERFLOW)
   ISR_TMR0
    BCF INTCON, T0IF
    MOVLW .100
    MOVWF TMR0

    CALL REFRES_DISP

    DECFSZ CONT_INT, F
    GOTO FIN_ISR
    MOVLW .2
    MOVWF CONT_INT

;SUBRUTINAS TIMER0
REFRES_DISP
    BCF PORTC, 0
    BCF PORTC, 1

    MOVF DIG_ACTUAL, W
    BTFSC STATUS, Z
    GOTO MOSTRAR_DIG0

    GOTO MOSTRAR_DIG1

  
MOSTRAR_DIG0
    MOVF DIG0, W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR

MOSTRAR_DIG1
    MOVF DIG1, W
    CALL TABLA_DISP
    MOVWF PORTD
    GOTO HABILITAR
    
HABILITAR
    MOVF DIG_ACTUAL, W
    CALL HABILITACION_DISPLAY
    MOVWF PORTC ;capaz hay que poner iorwf
  
SIG_DISP
    INCF DIG_ACTUAL, F
    MOVLW .2
    SUBWF DIG_ACTUAL, W
    BTFSS STATUS, Z
    RETURN

    CLRF DIG_ACTUAL
    RETURN
    
  RESET_99
  ;hacer que el motor gire antihorario?
    MOVLW .9
    MOVWF DIG0             
    MOVWF DIG1              
    RETURN
      
    
    
    
 ;FINAL DE INTERRUCIONES   
FIN_ISR
    SWAPF STATUS_TEMP, W
    MOVWF STATUS
    SWAPF W_TEMP, F
    SWAPF W_TEMP, W
    RETFIE
    
    
HABILITACION_DISPLAY
    ADDWF PCL,F
    RETLW b'00000001'  
    RETLW b'00000010' 
    
TABLA_DISP
    ADDWF PCL,F
    RETLW 0xC0 ;0
    RETLW 0xF9 ;1
    RETLW 0xA4 ;2
    RETLW 0xB0 ;3
    RETLW 0x99 ;4
    RETLW 0x92 ;5
    RETLW 0x82 ;6
    RETLW 0xF8 ;7
    RETLW 0x80 ;8
    RETLW 0x90 ;9
    
END
